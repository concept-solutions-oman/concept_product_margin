<odoo>
    <record id="view_product_margin_report_tree" model="ir.ui.view">
        <field name="name">product.margin.report.tree</field>
        <field name="model">product.margin.report</field>
        <field name="arch" type="xml">
           
            <tree string="Product Margin Report" create="false" edit="false" delete="false">
                <field name="product_id" widget="many2one_clickable"/>
                <field name="invoice_id" widget="many2one_clickable"/>
                <field name="invoice_date"/>
                <field name="quantity"/>
                <field name="price_unit" />
                <field name="cost" />
                <field name="margin" />
            </tree>

        </field>
    </record>

    <record id="view_product_margin_report_search" model="ir.ui.view">
        <field name="name">product.margin.report.search</field>
        <field name="model">product.margin.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" filter_domain="[]"/>
                <field name="invoice_number"/>
            
                <filter string="Today" name="today" domain="[('invoice_date', '=', context_today())]"/>
                <filter name="yesterday" string="Yesterday" domain="[('invoice_date', '=', (context_today() - relativedelta(days=1)))]"/> 
                <filter name="this_month" string="This Month" domain="[('invoice_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('invoice_date', '&lt;=', context_today())]" />
                <separator/>
                <filter string="Customer Invoices" name="filter_customer_invoice" domain="[('move_type','=','out_invoice')]"/>
                <filter string="Customer Credit Notes" name="filter_customer_credit" domain="[('move_type','=','out_refund')]"/>
                <filter string="Vendor Bills" name="filter_vendor_bill" domain="[('move_type','=','in_invoice')]"/>
                <filter string="Vendor Credit Notes" name="filter_vendor_credit" domain="[('move_type','=','in_refund')]"/>
                
                <separator/>
                <filter name="filter_invoice_date" string="Invoice Date" date="invoice_date"/>
                <separator/>

                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <separator/>
                    <filter name="group_by_invoice_date" string="Invoice Date" context="{'group_by': 'invoice_date'}"/>
                    <filter string="Invoice Number" name="group_invoice" context="{'group_by':'invoice_id'}"/>   
                    <filter string="Invoice Type" name="group_move_type" context="{'group_by':'move_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_margin_report" model="ir.actions.act_window">
        <field name="name">Product Margin Report</field>
        <field name="res_model">product.margin.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_product_margin_report_tree"/>
        <field name="search_view_id" ref="view_product_margin_report_search"/>
        <field name="context">{'group_by': 'product_id'}</field>
        <field name="domain">[('company_id', 'in', context.get('allowed_company_ids', []))]</field>
    </record>

    <menuitem id="menu_product_margin_root" name="Product Margin" parent="concept_account_reports.menu_concept_account_root" sequence="50" groups="base.group_no_one"/>
    <menuitem id="menu_product_margin_report" name="Product Margin Report" parent="menu_product_margin_root" action="action_product_margin_report" groups="account.group_account_manager"/>
</odoo>
